---
import "./IdentityInterlude.css";
---

<section class="identity-interlude" aria-label="Hassan Mushtaq identity">
  <div class="interlude-atmosphere" aria-hidden="true"></div>
  <div class="token-stage">
    <img
      class="identity-token"
      src="/assets/hm-token.webp"
      alt="Sculptural HM monogram in silver on a black token"
      width="1254"
      height="1254"
      loading="lazy"
    />
    <p class="mono token-caption">
      A human perspective.
      <br />A systems mindset.
    </p>
  </div>
</section>
