---
import { profile } from "../../content/profile";

import Action from "../ui/Action.astro";

import { experience } from "../../content/experience";
import { skills } from "../../content/skills";
import ExperienceRow from "../portfolio/ExperienceRow.astro";
import SkillRow from "../portfolio/SkillRow.astro";
import "./Experience.css";
---

<section class="experience section-pad" id="experience">
  <div class="display-heading reveal">
    <span class="mono">
      People, products,
      <br />
      and everything between.
    </span>
    <h2 class="text-cascade">Experience</h2>
    <span class="mono">({String(experience.length).padStart(2, "0")})</span>
  </div>
  <div class="experience-layout">
    <h3 class="experience-label">
      Where I've <br />
      made a difference.
    </h3>
    <div class="experience-list">
      {experience.map((entry) => (
        <ExperienceRow entry={entry} />
      ))}

      <Action
        href={profile.resume}
        label="Explore my resume"
        class="resume-link"
        arrow
        external
      />
    </div>
  </div>
  <div class="experience-layout skills-layout">
    <h3 class="experience-label">
      Skills, tools, <br />
      & soft knowledge.
    </h3>
    <div class="experience-list">
      {skills.map((skill, index) => (
        <SkillRow skill={skill} index={index} />
      ))}
    </div>
  </div>
</section>
