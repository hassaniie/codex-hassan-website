---
import { profile, mailto } from "../../content/profile";

import Action from "../ui/Action.astro";
import SocialLinks from "../ui/SocialLinks.astro";
import IdentityCard from "../portfolio/IdentityCard.astro";
import "./Hero.css";
---

<section class="hero" id="home">
  <div class="hero-atmosphere" aria-hidden="true"></div>
  <div class="hero-main">
    <div class="statement-frame">
      <picture>
        <source
          media="(max-width: 600px)"
          srcset="/assets/hero-curve-mobile.svg"
          width="18"
          height="166"
        />
        <img
          class="bracket left"
          src="/assets/hero-curve.svg"
          alt=""
          width="57"
          height="165"
        />
      </picture>
      <h1 class="split-reveal">
        Building complex digital interfaces for companies and brands that move
        forward.
      </h1>
      <picture>
        <source
          media="(max-width: 600px)"
          srcset="/assets/hero-curve-mobile.svg"
          width="18"
          height="166"
        />
        <img
          class="bracket right"
          src="/assets/hero-curve.svg"
          alt=""
          width="57"
          height="165"
        />
      </picture>
    </div>
    <IdentityCard />
  </div>
  <div class="hero-bottom">
    <SocialLinks includeResume />
    <Action href={mailto} label={profile.email} class="email-link" arrow />
  </div>
</section>
