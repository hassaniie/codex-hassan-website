---
import { profile, mailto } from "../../content/profile";
import Action from "../ui/Action.astro";
import Barcode from "../ui/Barcode.astro";

import SocialLinks from "../ui/SocialLinks.astro";
import "./footer.css";
interface Props {
  leading?: "resume" | "privacy";
}
const { leading = "resume" } = Astro.props;
---

<footer>
  <div class="footer-top">
    {leading === "privacy" ? (
      <Action size="small" href="/privacy-policy/" label="Privacy policy" />
    ) : (
      <Action size="small" href={profile.resume} label="Resume ↗" external />
    )}
    <SocialLinks />
    <Action size="small" href={mailto} label={`${profile.email} ↗`} />
  </div>
  <div class="footer-bottom">
    <span>© 2026 {profile.name}</span>
    <a class="footer-barcode" href="/#home" aria-label="Back to top">
      <Barcode accent label="H. MUSHTAQ" variant={8} />
    </a>
    <Action size="small" id="replay" label="Replay intro ↺" />
  </div>
</footer>
