---
import "./case-study.css";
import type { CaseImage, CaseStudy } from "../../content/case-studies";
import { projects } from "../../content/projects";
import Action from "../ui/Action.astro";

interface Props {
  study: CaseStudy;
}
const { study } = Astro.props;
const at = projects.findIndex((project) => project.id === study.projectId);
const project = projects[at];
// The next project that has somewhere to go, wrapping round the list.
const next = [...projects.slice(at + 1), ...projects.slice(0, at)].find(
  (candidate) => candidate.href && candidate.href !== project.href,
);
const nextExternal = Boolean(next?.href?.startsWith("http"));
// Every screen runs the width of the page, less its margins.
const sizes = "calc(100vw - 48px)";
const picture = (image: CaseImage) => ({
  src: image.src,
  srcset: image.srcset,
  sizes,
  width: image.width,
  height: image.height,
  alt: image.alt,
});
---

<article class="case" id="case">
  <header class="case-hero section-pad">
    <div class="case-hero-top mono">
      <span>( {project.year} )</span>
      <span>( Case study )</span>
    </div>
    <h1 class="case-title">
      {project.title.map((line, i) => (
        <>
          {i > 0 && <br />}
          {line}
        </>
      ))}
    </h1>
    <div class="case-intro">
      <div class="case-copy">
        <p>{study.intro}</p>
        <p class="mono case-facts">{study.facts.join(" · ")}</p>
      </div>
    </div>
    <img
      class="case-image case-lead"
      {...picture(study.lead)}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </header>

  {study.chapters.map((chapter) => (
    <section class="case-chapter section-pad">
      <div class="case-chapter-copy reveal">
        <div class="case-copy">
          <h2>{chapter.title}</h2>
          <p>{chapter.text}</p>
        </div>
      </div>
      {chapter.image && (
        <img
          class="case-image reveal"
          data-tone={chapter.tone ?? "light"}
          {...picture(chapter.image)}
          loading="lazy"
          decoding="async"
        />
      )}
    </section>
  ))}

  <nav class="case-next section-pad" aria-label="More work">
    {next && (
      <a
        class="case-next-link reveal"
        href={next.href}
        target={nextExternal ? "_blank" : undefined}
        rel={nextExternal ? "noopener" : undefined}
      >
        <span class="mono case-next-label">Next project</span>
        <span class="case-next-title">
          {next.title.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}{" "}
          <b aria-hidden="true">↗</b>
        </span>
      </a>
    )}
    <div class="case-all">
      <span class="mono">A few things I've put into the world.</span>
      <Action href="/works/" label="View All Works" size="responsive" arrow />
    </div>
  </nav>
</article>
