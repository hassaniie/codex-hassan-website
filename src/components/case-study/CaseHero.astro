---
import type { CaseStudySummary } from "../../content/case-studies/types";
import Action from "../ui/Action.astro";
import CaseFigure from "./CaseFigure.astro";
interface Props {
  study: CaseStudySummary;
}
const { study } = Astro.props;
---

<header class="case-hero" id="case-top">
  <div class="case-eyebrow mono">
    <Action href="/works/" label="← All works" size="small" data-case-return />
    <span>
      {study.project.title[0]} / {study.project.year}
    </span>
  </div>
  <div class="case-hero-layout">
    <div class="case-hero-brief">
      <h1>
        {study.headline.map((line) => (
          <span>{line}</span>
        ))}
      </h1>
      <p class="case-intro">{study.intro}</p>
      <dl class="case-brief">
        {study.brief.map((item) => (
          <div>
            <dt class="mono">{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>
    <CaseFigure
      image={study.project.image}
      fullSrc={study.fullArtwork}
      caption="The complete dashboard."
      number="01"
      eager
    />
  </div>
</header>
