---
import type { CaseFigure } from "../../content/case-studies";
interface Props {
  figure: CaseFigure;
  number: number;
  /** The width the image is drawn at, so the browser picks the right file. */
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { figure, number, sizes, eager = false, class: className } = Astro.props;
const { image, caption, tone = "light" } = figure;
---

<figure class:list={["case-figure", className]} data-tone={tone}>
  <div class="case-stage">
    <img
      src={image.src}
      srcset={image.srcset}
      sizes={sizes}
      width={image.width}
      height={image.height}
      alt={image.alt}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
    />
  </div>
  <figcaption class="mono">
    <span>(Fig. {String(number).padStart(2, "0")})</span> {caption}
  </figcaption>
</figure>
