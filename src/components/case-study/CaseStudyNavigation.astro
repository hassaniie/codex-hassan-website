---
import type { CaseStudyChapter } from "../../content/case-studies/types";
import Action from "../ui/Action.astro";
interface Props {
  chapters: readonly CaseStudyChapter[];
}
const { chapters } = Astro.props;
---

<nav class="case-reading-guide" aria-label="Case study chapters">
  <span class="mono case-guide-label">Explore the story</span>
  <ol>
    {chapters.map((chapter) => (
      <li>
        <Action
          href={`#${chapter.id}`}
          label={chapter.label}
          size="small"
          data-chapter-link
        />
      </li>
    ))}
  </ol>
</nav>
