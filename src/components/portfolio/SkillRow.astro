---
import "./experience-row.css";
import "./skill-row.css";
import type { Skill } from "../../content/skills";
interface Props {
  skill: Skill;
  index: number;
}
const { skill, index } = Astro.props;
---

<article class="experience-row skill-row reveal">
  <div class="experience-title">
    <h4>{skill.title}</h4>
    <span>({String(index + 1).padStart(2, "0")})</span>
  </div>
  <p>{skill.description}</p>
  {skill.tags && (
    <ul class="skill-tags">
      {skill.tags.map((tag) => (
        <li class="mono">{tag}</li>
      ))}
    </ul>
  )}
  {skill.tools && (
    <ul class="skill-tools">
      {skill.tools.map((tool) => (
        <li title={tool.name}>
          <img
            src={tool.logo}
            alt={tool.name}
            width="26"
            height="26"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  )}
</article>
