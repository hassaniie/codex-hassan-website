---
import "./experience-row.css";
import "./skill-row.css";
import type { Skill } from "../../content/skills";
interface Props {
  skill: Skill;
  index: number;
}
const { skill, index } = Astro.props;
// Black marks read as ink, like the rest of the page's type.
const ink = (hex: string) => (hex === "#000000" ? "var(--ink)" : hex);
---

<article class="experience-row skill-row reveal">
  <div class="experience-title">
    <h4>{skill.title}</h4>
    <span>({String(index + 1).padStart(2, "0")})</span>
  </div>
  <p>{skill.description}</p>
  {skill.tags && (
    <ul class="skill-tags">
      {skill.tags.map((tag) => (
        <li class="mono">{tag}</li>
      ))}
    </ul>
  )}
  {skill.tools && (
    <ul class="skill-tools">
      {skill.tools.map((tool) => (
        <li title={tool.name}>
          <svg
            viewBox="0 0 24 24"
            role="img"
            aria-label={tool.name}
            fill={ink(tool.hex)}
          >
            <path d={tool.path} />
          </svg>
        </li>
      ))}
    </ul>
  )}
</article>
