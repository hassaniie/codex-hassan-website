---
import "./project-card.css";
import type { Project } from "../../content/projects";
import Barcode from "../ui/Barcode.astro";
import Action from "../ui/Action.astro";
interface Props {
  project: Project;
  variant?: number;
}
const { project, variant = 0 } = Astro.props;
const paragraphs = [project.description].flat();
// A case study on this site opens in place; Behance opens in a new tab.
const external = Boolean(project.href?.startsWith("http"));
const name = project.title.join(" ");
// What the cursor circle says over the cover: where it leads, two lines.
const cursorLabel = !project.href
  ? "Coming|soon"
  : external
    ? "View on|Behance"
    : "Read|case study";
---

<article class="project reveal" data-categories={project.categories.join("|")}>
  {project.href ? (
    <Action
      appearance="media"
      label="Explore project ↗"
      class={`project-media ${project.id}-media`}
      href={project.href}
      external={external}
      data-cursor-label={cursorLabel}
      aria-label={
        external ? `View ${name} on Behance` : `Read the ${name} case study`
      }
    >
      <img {...project.image} loading="lazy" decoding="async" />
    </Action>
  ) : (
    <div
      class={`project-media ${project.id}-media`}
      data-cursor-label={cursorLabel}
    >
      <img {...project.image} loading="lazy" decoding="async" />
    </div>
  )}
  <div class="project-info">
    <div class="project-story">
      <div class="project-top">
        <h3>
          {project.title.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </h3>
        <span class="mono">({project.year})</span>
      </div>
      <div class="project-description">
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <ul class="tags">
          {project.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      </div>
    </div>
    <div class="project-bottom">
      {project.href ? (
        <Action
          href={project.href}
          label="View case study"
          weight="light"
          arrow
          external={external}
        />
      ) : (
        <span class="project-soon">Case study coming soon</span>
      )}
      <Barcode variant={variant} />
    </div>
  </div>
</article>
