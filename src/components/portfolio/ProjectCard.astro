---
import "./project-card.css";
import type { Project } from "../../content/projects";
import Barcode from "../ui/Barcode.astro";
import Action from "../ui/Action.astro";
interface Props {
  project: Project;
  variant?: number;
}
const { project, variant = 0 } = Astro.props;
const paragraphs = [project.description].flat();
---

<article class="project reveal" data-categories={project.categories.join("|")}>
  {project.href ? (
    <Action
      appearance="media"
      label="Explore project ↗"
      class={`project-media ${project.id}-media`}
      href={project.href}
      external
      aria-label={`View ${project.title.join(" ")} on Behance`}
    >
      <img {...project.image} loading="lazy" decoding="async" />
    </Action>
  ) : (
    <div class={`project-media ${project.id}-media`}>
      <img {...project.image} loading="lazy" decoding="async" />
    </div>
  )}
  <div class="project-info">
    <div class="project-story">
      <div class="project-top">
        <h3>
          {project.title.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </h3>
        <span class="mono">({project.year})</span>
      </div>
      <div class="project-description">
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <ul class="tags">
          {project.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      </div>
    </div>
    <div class="project-bottom">
      {project.href ? (
        <Action
          href={project.href}
          label="View case study"
          weight="light"
          arrow
          external
        />
      ) : (
        <span class="project-soon">Case study coming soon</span>
      )}
      <Barcode variant={variant} />
    </div>
  </div>
</article>
