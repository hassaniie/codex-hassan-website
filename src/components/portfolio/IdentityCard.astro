---
import "./identity-card.css";
import { profile } from "../../content/profile";
---

<a class="identity-card" href="/#about">
  <span class="identity-tab tab-left" aria-hidden="true">
    H
  </span>
  <div class="identity-surface">
    <img src={profile.portrait} alt="" width="80" height="80" />
    <div class="identity-copy">
      <span class="availability">
        {profile.availability} <i class="status-dot" aria-hidden="true"></i>
      </span>
      <h2>{profile.name}</h2>
      <p>{profile.role}</p>
    </div>
  </div>
  <span class="identity-tab tab-right" aria-hidden="true">
    M
  </span>
</a>
