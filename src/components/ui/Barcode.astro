---
interface Props {
  accent?: boolean;
  label?: string;
  variant?: number;
}
const { accent = false, label, variant = 0 } = Astro.props;
const widths = [1, 2, 1, 5, 2, 1, 1, 4, 2, 3, 1, 1, 5, 2, 1, 2, 4, 1, 3];
---

<div class:list={["barcode", { accent }]} aria-hidden="true">
  {label && <small>{label}</small>}
  {widths.map((_, i) => (
    <i
      style={`--bar:${widths[(i + variant * 3) % widths.length]};--i:${i}`}
    ></i>
  ))}
</div>
