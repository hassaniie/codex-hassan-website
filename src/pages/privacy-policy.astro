---
import SiteLayout from "../layouts/SiteLayout.astro";
import Footer from "../components/navigation/Footer.astro";
import { profile } from "../content/profile";
---

<SiteLayout
  title={`Privacy Policy — ${profile.name}`}
  description="Privacy information for messages sent through Hassan Mushtaq's portfolio."
  initialHeaderTheme="light"
  skipHref="#privacy"
  skipLabel="Skip to privacy policy"
>
  <article class="policy section-pad" id="privacy">
    <p class="mono">Privacy policy</p>
    <h1>Your message stays between us.</h1>
    <p>
      The contact form sends the details you enter (your name, email, company
      and message) to {profile.email}, and is used only to reply to you.
      Delivery is handled by FormSubmit (formsubmit.co), an email-forwarding
      service; this website does not store your details itself. If the form
      can't send, it opens your own email app with the message written
      instead.
    </p>
    <p>
      Once your message arrives, its handling is governed by my email
      provider. You can request deletion of our correspondence at any time by
      emailing {profile.email}.
    </p>
  </article>
  <section class="policy-footer">
    <Footer />
  </section>
</SiteLayout>

<style>
  .policy {
    min-height: 75svh;
    padding-top: 170px;
    padding-bottom: 100px;
  }
  .policy h1 {
    max-width: 900px;
    margin: 28px 0 60px;
    color: var(--color-accent);
    font-size: clamp(4rem, 8vw, 8rem);
    letter-spacing: -0.045em;
  }
  .policy > p:not(.mono) {
    max-width: 680px;
    margin-top: 24px;
    font-size: 1.125rem;
  }
  .policy-footer {
    padding-top: 100px;
    background: var(--color-action-dark-surface);
  }
</style>
