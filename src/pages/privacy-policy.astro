---
import SiteLayout from "../layouts/SiteLayout.astro";
import Footer from "../components/navigation/Footer.astro";
import { profile } from "../content/profile";
---

<SiteLayout
  title={`Privacy Policy — ${profile.name}`}
  description="Privacy information for messages sent through Hassan Mushtaq's portfolio."
  initialHeaderTheme="light"
  skipHref="#privacy"
  skipLabel="Skip to privacy policy"
>
  <article class="policy section-pad" id="privacy">
    <p class="mono">Privacy policy</p>
    <h1>Your message stays between us.</h1>
    <p>
      The contact form uses the details you enter only to prepare an email to{" "}
      {profile.email}. The website does not store or submit those details to a
      separate server.
    </p>
    <p>
      If you send that email, its handling is governed by your email provider
      and mine. You can request deletion of our correspondence at any time by
      emailing {profile.email}.
    </p>
  </article>
  <section class="policy-footer">
    <Footer />
  </section>
</SiteLayout>

<style>
  .policy {
    min-height: 75svh;
    padding-top: 170px;
    padding-bottom: 100px;
  }
  .policy h1 {
    max-width: 900px;
    margin: 28px 0 60px;
    color: var(--color-accent);
    font-size: clamp(4rem, 8vw, 8rem);
    letter-spacing: -0.045em;
  }
  .policy > p:not(.mono) {
    max-width: 680px;
    margin-top: 24px;
    font-size: 1.125rem;
  }
  .policy-footer {
    padding-top: 100px;
    background: var(--color-action-dark-surface);
  }
</style>
