---
import SiteLayout from "../layouts/SiteLayout.astro";
import Action from "../components/ui/Action.astro";
import { profile } from "../content/profile";
---

<SiteLayout
  title={`Page not found — ${profile.name}`}
  description="This page doesn't exist. Head back to Hassan Mushtaq's portfolio."
  initialHeaderTheme="light"
  skipHref="#not-found"
  skipLabel="Skip to page content"
>
  <div class="not-found">
    <section class="not-found-copy" id="not-found">
      <span class="not-found-chip mono">Error</span>
      <h1>404</h1>
      <p>
        This page wandered off. The link may be old, or the address may have a
        typo. Everything else is right where you left it.
      </p>
      <div class="not-found-links">
        <Action href="/" label="Back to home" arrow />
        <Action href="/works/" label="See all works" />
      </div>
    </section>
    <div class="not-found-visual" aria-hidden="true">
      <div class="not-found-token">
        <div class="coin">
          {Array.from({ length: 16 }, (_, i) => (
            <span class="coin-edge" style={`--i: ${i}`} />
          ))}
          <img
            class="coin-face coin-front"
            src="/assets/hm-token.webp"
            alt=""
            width="1254"
            height="1254"
          />
          <img
            class="coin-face coin-back"
            src="/assets/hm-token.webp"
            alt=""
            width="1254"
            height="1254"
          />
        </div>
      </div>
    </div>
  </div>
</SiteLayout>

<style>
  /* Two halves: the message on the light theme, the HM token turning in the
     hero's gradient. They stack on smaller screens, message first. */
  .not-found {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100svh;
  }
  .not-found-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 120px var(--gutter) 80px;
    text-align: center;
    color: var(--ink);
    background: var(--color-paper);
  }
  .not-found-chip {
    padding: 3px 7px;
    border: 1px solid currentColor;
    border-radius: var(--radius-small);
    color: var(--color-accent);
    font-size: var(--text-small);
    text-transform: uppercase;
  }
  .not-found-copy h1 {
    margin-top: 20px;
    color: var(--color-accent);
    font-size: clamp(7rem, 11vw, 11rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  .not-found-copy p {
    max-width: 380px;
    margin-top: 40px;
    font-size: var(--text-body-small);
    line-height: var(--leading-body);
  }
  .not-found-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 32px;
    margin-top: 28px;
  }

  /* The hero's atmosphere, layer for layer. */
  .not-found-visual {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    background: var(--atmosphere-gradient);
  }
  .not-found-visual::before,
  .not-found-visual::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .not-found-visual::before {
    background: var(--atmosphere-edge-overlay);
    mix-blend-mode: overlay;
  }
  .not-found-visual::after {
    background: var(--atmosphere-edge-shade);
  }
  /*
   * A full turn needs a real object, not a flat picture: the token is the
   * face on both sides (the back turned round so HM reads correctly), with
   * a stack of dark discs between them for the rim, so the coin keeps its
   * thickness when it passes edge-on.
   */
  .not-found-token {
    --coin: clamp(280px, 30vw, 520px);
    --thickness: calc(var(--coin) * 0.05);
    width: var(--coin);
    aspect-ratio: 1;
    perspective: 1400px;
    filter: drop-shadow(0 35px 25px #1113);
    animation: not-found-float 4s ease-in-out infinite alternate;
  }
  .coin {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(8deg) rotateZ(-6deg);
    animation: not-found-spin 8s linear infinite;
  }
  .coin-face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }
  .coin-front {
    transform: translateZ(calc(var(--thickness) / 2));
  }
  .coin-back {
    transform: rotateY(180deg) translateZ(calc(var(--thickness) / 2));
  }
  /* Sized to sit just inside the face, so it only shows side-on. */
  .coin-edge {
    position: absolute;
    top: 13%;
    left: 13%;
    width: 74%;
    height: 74%;
    border-radius: 50%;
    background: linear-gradient(90deg, #111113, #34343a 50%, #111113);
    transform: translateZ(
      calc(var(--thickness) * (var(--i) / 15 - 0.5) * 0.94)
    );
  }
  @keyframes not-found-spin {
    from {
      transform: rotateX(8deg) rotateZ(-6deg) rotateY(0deg);
    }
    to {
      transform: rotateX(8deg) rotateZ(-6deg) rotateY(360deg);
    }
  }
  @keyframes not-found-float {
    from {
      translate: 0 12px;
    }
    to {
      translate: 0 -12px;
    }
  }

  /* The navbar spans both halves: over the gradient its right side turns
     white, and the centred clock moves over the message so it never sits
     on the seam. */
  @media (min-width: 901px) {
    :global(:root:has(.not-found) .site-header .header-right) {
      color: var(--color-paper);
      --action-accent: var(--color-action-on-dark);
      --action-icon-ink: var(--color-action-dark-surface);
    }
    :global(:root:has(.not-found) .site-header .location) {
      left: 25%;
    }
  }

  @media (max-width: 900px) {
    .not-found {
      grid-template-columns: 1fr;
    }
    .not-found-copy {
      padding: 140px var(--gutter) 72px;
    }
    .not-found-visual {
      min-height: max(420px, 55svh);
    }
    .not-found-token {
      --coin: min(300px, 70vw);
    }
  }
</style>
