---
/*
 * A temporary page for choosing the site's text motion: the same real
 * headings under each option, side by side. Linked from nowhere and left out
 * of the sitemap; it is deleted once a motion is chosen.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import "../components/sections/Principles.css";
import { profile } from "../content/profile";

const options = [
  {
    id: "today",
    mark: "00",
    name: "Today",
    note: "Letters flip up from a 3D tilt, tied to your scroll. Scroll up and down through it.",
  },
  {
    id: "lines",
    mark: "A",
    name: "Line reveal",
    note: "Each line slides up from behind an invisible edge. Plays once.",
    pick: true,
  },
  {
    id: "words",
    mark: "B",
    name: "Word cascade",
    note: "Words fade in and rise slightly, one after another. Plays once.",
  },
  {
    id: "chars",
    mark: "C",
    name: "Letter fade",
    note: "Letters fade and rise, with no 3D tilt. Plays once.",
  },
];
const labels = [
  "(01) / The problem",
  "Selected explorations",
  "Good things start with a conversation",
  "Explore the story",
];
---

<SiteLayout
  title={`Motion lab — ${profile.name}`}
  description="A temporary page for comparing text motion."
  initialHeaderTheme="light"
  skipHref="#lab"
  skipLabel="Skip to motion lab"
>
  <div class="lab section-pad" id="lab">
    <header class="lab-intro">
      <span class="mono">Temporary page · not linked anywhere</span>
      <h1>Text motion, side by side.</h1>
      <p>
        Each option runs on the site’s real headings. Scroll down to see each
        one arrive, or press Replay to watch it again.
      </p>
      <p class="mono lab-reduced">
        Your device asks for reduced motion, so nothing moves here. Turn that
        setting off to compare.
      </p>
    </header>

    {options.map((option) => (
      <section class="lab-option" data-lab-option={option.id}>
        <div class="lab-option-head">
          <span class="mono lab-mark">({option.mark})</span>
          <h2>
            {option.name}
            {option.pick && <span class="mono lab-pick">Your pick</span>}
          </h2>
          <p>{option.note}</p>
          {option.id !== "today" && (
            <button class="mono lab-replay" type="button" data-lab-replay>
              Replay ↺
            </button>
          )}
        </div>

        <div class="display-heading lab-specimen">
          <span class="mono">
            Selected explorations
            <br />
            (2025 — 2026)
          </span>
          <h3 data-lab-text>Projects</h3>
          <span class="mono">(03)</span>
        </div>

        <div class="statement-frame about-statement lab-specimen">
          <span class="side-letter" aria-hidden="true">
            Ⓗ
          </span>
          <p data-lab-text>
            I bring clarity to complex products. From the first question to the
            final interaction, I design around the people who use them.
          </p>
          <span class="side-letter" aria-hidden="true">
            Ⓜ
          </span>
        </div>

        <div class="lab-case lab-specimen">
          <span class="mono">(01) / The problem</span>
          <h3 data-lab-text>A useful answer before another number.</h3>
        </div>

        <div class="lab-contact lab-specimen">
          <h3 data-lab-text>
            A product to rethink, a team to join,
            <br /> or an idea you can't leave alone.
          </h3>
        </div>
      </section>
    ))}

    <section class="lab-option" data-lab-option="decode">
      <div class="lab-option-head">
        <span class="mono lab-mark">(+)</span>
        <h2>Decode, an optional extra</h2>
        <p>
          For the small mono labels only: letters shuffle briefly, then settle.
          Plays once.
        </p>
        <button class="mono lab-replay" type="button" data-lab-replay>
          Replay ↺
        </button>
      </div>
      <ul class="lab-labels lab-specimen">
        {labels.map((label) => (
          <li class="mono" data-lab-label>
            {label}
          </li>
        ))}
      </ul>
    </section>
  </div>
  <script>
    import { initMotionLab } from "../scripts/motion-lab";
    initMotionLab();
  </script>
</SiteLayout>

<style is:global>
  .lab {
    max-width: 80rem;
    margin-inline: auto;
    padding-block: 9rem 40vh;
  }
  .lab-intro {
    max-width: 40rem;
    color: var(--ink);
  }
  .lab-intro > .mono {
    color: var(--accent);
    font-size: var(--text-small);
  }
  .lab-intro h1 {
    margin-top: var(--space-4);
    color: var(--color-heading-accent);
    font-size: clamp(2.75rem, 5vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .lab-intro p {
    margin-top: var(--space-5);
    font-size: var(--text-body-small);
    line-height: var(--leading-body-small);
  }
  .lab-reduced {
    display: none;
    color: var(--color-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .lab-reduced {
      display: block;
    }
  }
  .lab-option {
    margin-top: 30vh;
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .lab-option-head {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
  }
  .lab-mark {
    color: var(--accent);
    font-size: var(--text-small);
  }
  .lab-option-head h2 {
    font-size: clamp(2rem, 3.2vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .lab-pick {
    margin-left: var(--space-4);
    padding: 3px 8px;
    border-radius: var(--radius-small);
    background: var(--accent);
    color: var(--color-paper);
    font-size: var(--text-small);
    letter-spacing: 0;
    vertical-align: middle;
  }
  .lab-option-head p {
    grid-column: 2;
    max-width: 36rem;
    color: var(--color-muted);
    font-size: var(--text-body-small);
    line-height: var(--leading-body-small);
  }
  .lab-replay {
    grid-column: 3;
    grid-row: 1;
    padding: 8px 14px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-control);
    background: none;
    color: var(--ink);
    font-size: var(--text-small);
    cursor: pointer;
  }
  .lab-specimen {
    margin-top: 22vh;
  }
  .lab .display-heading {
    margin-bottom: 0;
  }
  .lab .display-heading h3 {
    color: var(--color-heading-accent);
    font-size: clamp(100px, 14vw, 220px);
    letter-spacing: -0.05em;
  }
  .lab .about-statement {
    margin-block: 22vh 0;
  }
  .lab-case {
    max-width: 50rem;
    margin-inline: auto;
  }
  .lab-case > .mono {
    display: block;
    margin-bottom: var(--space-4);
    color: var(--color-label-accent);
    font-size: var(--text-small);
  }
  .lab-case h3 {
    max-width: 40rem;
    font-size: clamp(2rem, 3.2vw, 3rem);
    line-height: var(--leading-display);
    letter-spacing: -0.025em;
  }
  .lab-contact {
    display: grid;
    place-items: center;
    padding: 18vh var(--gutter);
    border-radius: var(--radius-card);
    /* The contact section's blue, where its headline sits. */
    background: linear-gradient(180deg, #7d82f2, #494fed 55%, #2a30e6);
    text-align: center;
  }
  .lab-contact h3 {
    max-width: 900px;
    color: var(--color-paper);
    font-size: clamp(36px, 4vw, 62px);
    letter-spacing: -0.025em;
  }
  .lab-labels {
    display: grid;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    color: var(--color-label-accent);
    font-size: var(--text-meta);
  }
  /* Room inside each line's clip, so descenders and accents are not cut. */
  .lab-line-mask {
    padding-block: 0.08em 0.14em;
    margin-block: -0.08em -0.14em;
  }
  .lab .word,
  .lab .char {
    display: inline-block;
  }
  @media (max-width: 600px) {
    .lab-option-head {
      grid-template-columns: 1fr auto;
    }
    .lab-option-head > * {
      grid-column: auto;
    }
    .lab-option-head h2 {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .lab-option-head p {
      grid-column: 1 / -1;
    }
    .lab .display-heading h3 {
      font-size: 72px;
    }
    .lab .about-statement p {
      font-size: 32px;
    }
    .lab-contact h3 br {
      display: none;
    }
  }
</style>
