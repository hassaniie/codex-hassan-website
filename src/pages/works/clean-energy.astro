---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { energyCaseStudy as study } from "../../content/case-studies/energy";
import CaseHero from "../../components/case-study/CaseHero.astro";
import CaseChapter from "../../components/case-study/CaseChapter.astro";
import CaseFigure from "../../components/case-study/CaseFigure.astro";
import CaseStudyNavigation from "../../components/case-study/CaseStudyNavigation.astro";
import ArtworkViewer from "../../components/case-study/ArtworkViewer.astro";
import Action from "../../components/ui/Action.astro";
import Contact from "../../components/sections/Contact.astro";
import "../../components/case-study/case-study.css";
---

<SiteLayout
  title="Clean Energy Analytics — A case study by Hassan Mushtaq"
  description={study.intro}
  initialHeaderTheme="light"
  skipHref="#overview"
  skipLabel="Skip to case study"
  socialImage={{
    src: "/assets/projects/energy-meadow-1200.webp",
    alt: study.project.image.alt,
    width: 1200,
    height: 1600,
  }}
>
  <article
    class="case-study section-pad"
    aria-label="Clean energy analytics case study"
  >
    <CaseHero study={study} />
    <CaseStudyNavigation chapters={study.chapters} />
    <div class="case-body">
      <div class="case-story">
        <CaseChapter {...study.chapters[0]} title={study.overview.title}>
          <div class="case-copy">
            {study.overview.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </CaseChapter>
        <CaseChapter {...study.chapters[1]} title={study.hierarchy.title}>
          <p class="case-copy">{study.hierarchy.intro}</p>
          <ol class="case-decisions">
            {study.hierarchy.decisions.map((decision) => (
              <li class="case-decision">
                <div>
                  <h3>{decision.question}</h3>
                  <p>{decision.description}</p>
                </div>
              </li>
            ))}
          </ol>
          <CaseFigure
            image={study.project.image}
            fullSrc={study.fullArtwork}
            caption="A closer look at the performance hierarchy."
            number="02"
            variant="performance"
          />
        </CaseChapter>
        <CaseChapter {...study.chapters[2]} title={study.visualLanguage.title}>
          <div class="case-copy">
            {study.visualLanguage.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <CaseFigure
            image={study.project.image}
            fullSrc={study.fullArtwork}
            caption="Environmental benefits, given their own space."
            number="03"
            variant="impact"
          />
        </CaseChapter>
        <CaseChapter {...study.chapters[3]} title={study.reflection.title}>
          <div class="case-copy">
            {study.reflection.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <p class="case-note">{study.reflection.note}</p>
        </CaseChapter>
      </div>
    </div>
    <nav class="case-end" aria-label="Continue exploring">
      <Action href="/works/" label="Back to all works" weight="light" arrow />
      <Action href="#case-top" label="Back to top ↑" weight="light" />
    </nav>
  </article>
  <Contact />
  <ArtworkViewer
    image={study.project.image}
    fullSrc={study.fullArtwork}
    title="Clean energy / Full artwork"
  />
  <script>
    import { initCaseStudyPage } from "../../scripts/case-study-page";
    initCaseStudyPage();
  </script>
</SiteLayout>
