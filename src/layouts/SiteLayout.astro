---
import "../styles/global.css";
import { profile } from "../content/profile";

import Header from "../components/navigation/Header.astro";
import Intro from "../components/ui/Intro.astro";

interface Props {
  title?: string;
  description?: string;
  initialHeaderTheme?: "dark" | "light";
  skipHref?: string;
  skipLabel?: string;
}
const {
  title = profile.title,
  description = profile.description,
  initialHeaderTheme = "dark",
  skipHref = "#work",
  skipLabel = "Skip to selected work",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL("/og-image.jpg", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#25296b" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${profile.name}, ${profile.role}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="any"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' fill='white'/%3E%3Cpath d='M10.5 6.5h3v3h-3zM26.5 6.5h3v3h-3zM10.5 10.5h3v3h-3zM26.5 10.5h3v3h-3zM10.5 14.5h3v3h-3zM26.5 14.5h3v3h-3zM10.5 18.5h3v3h-3zM14.5 18.5h3v3h-3zM18.5 18.5h3v3h-3zM22.5 18.5h3v3h-3zM26.5 18.5h3v3h-3zM10.5 22.5h3v3h-3zM26.5 22.5h3v3h-3zM10.5 26.5h3v3h-3zM26.5 26.5h3v3h-3zM10.5 30.5h3v3h-3zM26.5 30.5h3v3h-3z' fill='black'/%3E%3C/svg%3E"
    />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/assets/instrument.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/geist-mono.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <script is:inline>
      // Arm the curtain before first paint so content never flashes ahead of
      // it. Every document opens the same way, whether it was reached by a
      // reload or by a link, because that is what the source does and it is
      // the only way a link click shows one count instead of two. Reduced
      // motion opts out entirely, and the timer guarantees the page is
      // revealed even if the bundle never runs.
      (function () {
        var root = document.documentElement;
        try {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;
        } catch (error) {
          return;
        }
        root.classList.add("intro-armed");
        setTimeout(function () {
          root.classList.remove("intro-armed");
        }, 4000);
      })();
    </script>
    <a class="skip-link" href={skipHref}>
      {skipLabel}
    </a>
    <Intro />
    <div class="cursor-dot" aria-hidden="true"></div>
    <Header initialTheme={initialHeaderTheme} />
    <main>
      <slot />
    </main>
    <div class="toast" role="status" aria-live="polite"></div>
    <script>
      import { initSite } from "../scripts/site";
      initSite();
    </script>
  </body>
</html>
